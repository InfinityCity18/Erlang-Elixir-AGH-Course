IO.puts(((fn ->
m
|> Enum.each(
  fn %{stationName: name, location: coords, datetime: dt, pollutionType: type, pollutionLevel: level} -> 
    :pollution_gen_server.add_station(name, coords)
  end) 
  end
)
|> :timer.tc 
|> elem(0) )/ 1000000)

